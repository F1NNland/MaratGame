  chapterLabel: "\u0413\u041B\u0410\u0412\u0410 4 \xB7 \u041A\u0420\u0420\u0411 /
    \u0423\u041A"
  bodyText: "\u0411\u043B\u043E\u043A \u041A\u0420\u0420\u0411/\u0423\u041A \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u0441 \u043D\u0435\u043B\u043E\u0432\u043A\u043E\u0439 \u043F\u0430\u0443\u0437\u044B:
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445 \u043C\u0435\u0441\u0442
    \u043C\u0430\u043B\u043E, \u0430 \u0442\u043E\u043D \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430
    \u0435\u0449\u0451 \u043D\u0435 \u0437\u0430\u0434\u0430\u043D. \u041D\u0443\u0436\u043D\u043E
    \u0432\u044B\u0431\u0440\u0430\u0442\u044C, \u0433\u0434\u0435 \u0441\u0435\u0441\u0442\u044C,
    \u0438 \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u0437\u0430\u0432\u0438\u0441\u0438\u0442,
    \u043A\u0430\u043A \u043F\u043E\u0439\u0434\u0451\u0442 \u043E\u0441\u0442\u0430\u0432\u0448\u0430\u044F\u0441\u044F
    \u0447\u0430\u0441\u0442\u044C \u0434\u043D\u044F."
