  chapterLabel: "\u0413\u041B\u0410\u0412\u0410 3 \xB7 \u041F\u041B\u0410\u041D\u0415\u0420\u041A\u0410"
  bodyText: "\u041F\u0440\u043E\u0435\u043A\u0442\u043E\u0440 \u0441\u043D\u043E\u0432\u0430
    \u043D\u0435 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F,
    \u0432 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u043A\u0435 \u043F\u043E\u0432\u0438\u0441\u0430\u0435\u0442
    \u043F\u0430\u0443\u0437\u0430. \u041A\u043E\u043C\u0430\u043D\u0434\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
    \u043D\u0430 \u0432\u0430\u0441 \u2014 \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u0441\u0442\u0440\u043E
    \u0437\u0430\u0434\u0430\u0442\u044C \u0442\u043E\u043D \u0432\u0441\u0442\u0440\u0435\u0447\u0438."
  speaker: "\u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C"
