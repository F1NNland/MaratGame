    \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442\u0435
    \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u043F\u043E \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u0443,
    \u0438 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u0435\u0435."
