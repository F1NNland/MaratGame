  chapterLabel: "\u0413\u041B\u0410\u0412\u0410 2 \xB7 \u0414\u041E \u041F\u041B\u0410\u041D\u0415\u0420\u041A\u0418"
  bodyText: "\u0418\u0437 \u0441\u0440\u0435\u0434\u043D\u0435\u0439 \u043A\u0430\u0431\u0438\u043D\u043A\u0438
    \u0441\u043D\u043E\u0432\u0430 \u0441\u043B\u044B\u0448\u0438\u0442\u0441\u044F
    \u0442\u0438\u0445\u043E\u0435: \xAB\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435...
    \u043D\u0435 \u043F\u043E\u0434\u0441\u043A\u0430\u0436\u0435\u0442\u0435, \u043A\u0430\u043A
    \u0431\u044B\u0441\u0442\u0440\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u043F\u0440\u043E\u043F\u0443\u0441\u043A?\xBB. \u0412\u044B \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C,
    \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
    \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E."
