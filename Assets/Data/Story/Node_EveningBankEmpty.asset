  bodyText: "\u0412 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430\u0445 \u043F\u043E\u0447\u0442\u0438
    \u0442\u0438\u0445\u043E: \u043A\u0442\u043E-\u0442\u043E \u0443\u0436\u0435
