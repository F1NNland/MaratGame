  bodyText: "\u0421 \u0437\u0430\u0434\u043D\u0435\u0433\u043E \u0440\u044F\u0434\u0430
    \u0432\u0438\u0434\u043D\u043E \u0432\u0441\u0435\u0445 \u0441\u0440\u0430\u0437\u0443:
    \u043A\u0442\u043E \u043A\u0438\u0432\u0430\u0435\u0442 \u0444\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E,
    \u043A\u0442\u043E \u0440\u0435\u0430\u043B\u044C\u043D\u043E \u0432\u043A\u043B\u044E\u0447\u0451\u043D,
    \u043A\u0442\u043E \u0443\u0441\u0442\u0430\u043B. \u0414\u043B\u0438\u043D\u043D\u044B\u0435
    \u0440\u0435\u043F\u043B\u0438\u043A\u0438 \u0437\u0432\u0443\u0447\u0430\u0442
    \u0442\u0438\u0448\u0435, \u0437\u0430\u0442\u043E \u043F\u0440\u043E\u0449\u0435
    \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u044C \u043E\u0431\u0449\u0443\u044E
    \u0434\u0438\u043D\u0430\u043C\u0438\u043A\u0443 \u0437\u0430\u043B\u0430."
  speaker: "\u041C\u0430\u0440\u0430\u0442"
