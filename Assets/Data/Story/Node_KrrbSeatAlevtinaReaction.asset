  bodyText: "\u2014 \u0425\u043E\u0440\u043E\u0448\u043E, \u0447\u0442\u043E \u0441\u0435\u043B
    \u0440\u044F\u0434\u043E\u043C. \u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u0439\u0434\u0443\u0442
    \u0434\u043B\u0438\u043D\u043D\u044B\u0435 \u0441\u0442\u0430\u0442\u0443\u0441\u044B,
    \u0438 \u0432\u0430\u0436\u043D\u043E \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
