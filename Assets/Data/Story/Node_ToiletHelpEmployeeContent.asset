  chapterLabel: "\u0413\u041B\u0410\u0412\u0410 2 \xB7 \u0414\u041E \u041F\u041B\u0410\u041D\u0415\u0420\u041A\u0418"
  bodyText: "\u2014 \u042F \u043F\u0435\u0440\u0432\u044B\u0439 \u0434\u0435\u043D\u044C
    \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0430.
    \u041F\u0440\u043E\u043F\u0443\u0441\u043A \u043D\u0435 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F,
    \u0430 \u0447\u0435\u0440\u0435\u0437 \u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442
    \u043F\u043B\u0430\u043D\u0451\u0440\u043A\u0430.\n\u2014 \u0421\u0435\u0439\u0447\u0430\u0441
    \u0431\u044B\u0441\u0442\u0440\u043E \u0440\u0435\u0448\u0438\u043C. \u0413\u043B\u0430\u0432\u043D\u043E\u0435
    \u2014 \u0431\u0435\u0437 \u0441\u0443\u0435\u0442\u044B.\n\n\u0412\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435,
    \u043A\u0430\u043A \u043F\u043E\u043C\u043E\u0447\u044C \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B
    \u0438 \u0443\u0441\u043F\u0435\u043B \u043D\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0443."
  speaker: "\u0421\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A"
