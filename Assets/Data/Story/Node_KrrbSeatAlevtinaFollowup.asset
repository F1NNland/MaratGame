    \u0423\u041A"
  bodyText: "\u0414\u043E\u043A\u043B\u0430\u0434 \u0442\u044F\u043D\u0435\u0442\u0441\u044F
    \u0434\u043E\u043B\u044C\u0448\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E,
    \u043D\u043E \u0440\u044F\u0434\u043E\u043C \u0441 \u0410\u043B\u0435\u0432\u0442\u0438\u043D\u043E\u0439
    \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F \u0434\u0435\u0440\u0436\u0430\u0442\u044C
    \u043E\u0431\u0449\u0438\u0439 \u0440\u0438\u0442\u043C. \u0412\u0430\u0448\u0438
    \u0443\u0442\u043E\u0447\u043D\u0435\u043D\u0438\u044F \u0441\u043B\u044B\u0448\u0430\u0442,
    \u0438 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u0435\u0435."
  speaker: "\u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C"
