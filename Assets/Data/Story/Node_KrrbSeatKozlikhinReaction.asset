  bodyText: "\u2014 \u0421\u0430\u0434\u0438\u0441\u044C \u0431\u043B\u0438\u0436\u0435,
    \u0441\u0435\u0439\u0447\u0430\u0441 \u0431\u0443\u0434\u0435\u0442 \u043C\u043D\u043E\u0433\u043E
    \u0441\u043F\u043E\u0440\u043D\u044B\u0445 \u043C\u0435\u0441\u0442 \u043F\u043E
    \u0423\u041A. \u041A\u043E\u0437\u043B\u0438\u0445\u0438\u043D \u0448\u0435\u043F\u0447\u0435\u0442
    \u043A\u043E\u043C\u043C\u0435\u043D\u0442\u0430\u0440\u0438\u0438 \u043C\u0435\u0436\u0434\u0443
