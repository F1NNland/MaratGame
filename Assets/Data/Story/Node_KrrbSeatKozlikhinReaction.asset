    \u0434\u043E\u043A\u043B\u0430\u0434\u0447\u0438\u043A\u0430, \u0438 \u0442\u0435\u043C\u043F
    \u0437\u0430\u043C\u0435\u0442\u043D\u043E \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442\u0441\u044F."
