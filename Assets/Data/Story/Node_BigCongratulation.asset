  id: big_congratulation
  locationId: hall
  timeDisplay: 18:40
  dayBlock: 6
  chapterLabel: "\u0424\u0418\u041D\u0410\u041B \xB7 \u0411\u041E\u041B\u042C\u0428\u041E\u0415
    \u041F\u041E\u0417\u0414\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415"
  bodyText: "\u0421\u0432\u0435\u0442 \u0432 open space \u043F\u0440\u0438\u0433\u043B\u0443\u0448\u0430\u044E\u0442,
    \u0438 \u043A\u043E\u043B\u043B\u0435\u0433\u0438 \u043F\u043E\u0447\u0442\u0438
    \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u043D\u043E \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u043A \u0432\u0430\u043C: \xAB\u0421 \u0434\u043D\u0451\u043C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F,
    \u041C\u0430\u0440\u0430\u0442!\xBB \u0422\u043E\u0440\u0442, \u0430\u043F\u043B\u043E\u0434\u0438\u0441\u043C\u0435\u043D\u0442\u044B,
    \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u0442\u0451\u043F\u043B\u044B\u0435
    \u0442\u043E\u0441\u0442\u044B \u2014 \u0434\u0435\u043D\u044C \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0432\u044B\u0441\u043E\u043A\u043E\u0439, \u043D\u043E \u043E\u0447\u0435\u043D\u044C
    \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0439 \u043D\u043E\u0442\u0435.\n\n\xAB\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
    \u0440\u0430\u0434\u0438 \u044D\u0442\u043E\u0433\u043E \u0432\u0441\u0451 \u0438
    \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442.\xBB"
